{
	"name": "ftnui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"precheck": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"codegen": "graphql-codegen --config codegen.yml && pnpm run fix-imports",
		"codegen:watch": "graphql-codegen --config codegen.yml --watch",
		"codegen:mut": "graphql-codegen --config codegen.mut.yml && pnpm run fix-imports",
		"codegen:mut:watch": "graphql-codegen --config codegen.mut.yml --watch",
		"codegen:all": "pnpm run codegen && pnpm run codegen:mut",
		"fix-imports": "sed -i \"s/import { DocumentNode } from 'graphql';/import type { DocumentNode } from 'graphql';/g\" src/lib/generated/*.ts"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@graphql-codegen/cli": "^5.0.7",
		"@graphql-codegen/typescript": "^4.1.6",
		"@graphql-codegen/typescript-generic-sdk": "^3.1.0",
		"@graphql-codegen/typescript-operations": "^4.6.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@storybook/addon-a11y": "10.6.0",
		"@storybook/addon-docs": "10.6.0",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "10.6.0",
		"@storybook/sveltekit": "10.6.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"graphql": "^16.14.2",
		"graphql-tag": "^2.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"storybook": "^10.6.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
		"@opentelemetry/sdk-node": "^0.222.0"
	}
}
